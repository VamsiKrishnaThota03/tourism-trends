# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# true only for local development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins when deployed behind HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional SQLite file location (defaults to ./db.sqlite3)
SQLITE_PATH=
# Max CSV upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Production hardening. All default to the secure value; override only when the
# deployment genuinely needs it (for example a plain-HTTP host).
# Enabling HSTS is effectively irreversible for the length of max-age.
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# Left false on purpose: browser preload submission is permanent.
DJANGO_HSTS_PRELOAD=false
